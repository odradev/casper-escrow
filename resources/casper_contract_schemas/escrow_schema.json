  "entry_points": [
    {
      "name": "create_deal",
      "description": "Opens a deal with the caller as the buyer and takes the deposit. For a CSPR deal `token` is `None`, exactly `deposit` motes must be attached and every party must be an account. For a token deal nothing is attached and the caller must have approved this contract for `deposit` of `token`. The id of the new deal is the value `deals_count` returned before the call; the `DealCreated` event carries it. The argument cannot be called `amount`: Odra passes the attached CSPR under that name. `delivery_deadline` is a moment in milliseconds since the Unix epoch; `review_period` and `dispute_period` are lengths in milliseconds.",
      "is_mutable": true,
      "is_payable": true,
      "arguments": [
        {
          "name": "seller",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "arbiter",
          "description": null,
          "ty": {
            "Option": "Key"
          },
          "optional": false
        },
        {
          "name": "token",
          "description": null,
          "ty": {
            "Option": "Key"
          },
          "optional": false
        },
        {
          "name": "deposit",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "arbiter_fee",
          "description": null,
          "ty": "U256",
          "optional": false
        },
        {
          "name": "default_seller_bps",
          "description": null,
          "ty": "U32",
          "optional": false
        },
        {
          "name": "delivery_deadline",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "review_period",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "dispute_period",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "memo",
          "description": null,
          "ty": "String",
          "optional": false
        },
        {
          "name": "__cargo_purse",
          "description": null,
          "ty": "URef",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "mark_delivered",
      "description": "Says the work is delivered and starts the buyer's review period. Only the seller may call it, on a `Funded` deal, before the delivery deadline.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "dispute",
      "description": "Disputes the delivery and starts the dispute period. Only the buyer may call it, on a `Delivered` deal, before the review period ends.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "release",
      "description": "Pays the whole deposit to the seller. Only the buyer may call it, on any open deal.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "refund",
      "description": "Sends the whole deposit back to the buyer. Only the seller may call it, on any open deal.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "resolve",
      "description": "Decides a dispute: the arbiter takes the fee, `seller_share` goes to the seller and the rest back to the buyer. Only the arbiter may call it, on a `Disputed` deal, before the dispute period ends.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "seller_share",
          "description": null,
          "ty": "U256",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "offer_split",
      "description": "Offers a settlement: `seller_share` of the deposit to the seller, the rest back to the buyer. Only the buyer or the seller may call it, on any open deal. Each party has one offer; calling again replaces it and `None` withdraws it. When the offers of the two parties are the same amount, the deal closes with that split and the arbiter gets nothing. An offer does not stop any time limit of the deal.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        },
        {
          "name": "seller_share",
          "description": null,
          "ty": {
            "Option": "U256"
          },
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "settle",
      "description": "Closes a deal whose time limit has passed, by the rule of its state. Anyone may call it. - `Funded`, from the delivery deadline on: the deposit goes back to the buyer. - `Delivered`, from the end of the review period on: the deposit goes to the seller. - `Disputed`, from the end of the dispute period on: the deposit is split by `default_seller_bps`, and the arbiter gets nothing.",
      "is_mutable": true,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Unit",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "deal",
      "description": "Returns the deal with the given id.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "deal_id",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "Deal",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "deals_count",
      "description": "Returns the number of deals created. Ids run from `0` to `count - 1`.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "deals_count_of",
      "description": "Returns the number of deals `account` is a party of, in any role.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "account",
          "description": null,
          "ty": "Key",
          "optional": false
        }
      ],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    },
    {
      "name": "deal_id_of",
      "description": "Returns the id of a deal of `account` by its position, `0` to `deals_count_of - 1`, in the order the deals were created.",
      "is_mutable": false,
      "is_payable": false,
      "arguments": [
        {
          "name": "account",
          "description": null,
          "ty": "Key",
          "optional": false
        },
        {
          "name": "index",
          "description": null,
          "ty": "U64",
          "optional": false
        }
      ],
      "return_ty": "U64",
      "is_contract_context": true,
      "access": "public"
    }
  ],
