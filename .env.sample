# Settings of the CLI (bin/cli.rs). Copy to `.env` and fill in.

# The secret key of the account that deploys the contract and pays for the transactions.
# For NCTL, copy the test users' keys out of the container first:
#   for i in 1 2 3 4 5; do
#     docker exec mynctl cat /home/casper/casper-nctl/assets/net-1/users/user-$i/secret_key.pem > .node-keys/user-$i.pem
#     docker exec mynctl cat /home/casper/casper-nctl/assets/net-1/users/user-$i/public_key_hex > .node-keys/user-$i.pub
#   done
ODRA_CASPER_LIVENET_SECRET_KEY_PATH=.node-keys/user-1.pem

# A local NCTL network. For the testnet: https://node.testnet.casper.network and casper-test.
ODRA_CASPER_LIVENET_NODE_ADDRESS=http://localhost:11101
ODRA_CASPER_LIVENET_EVENTS_URL=http://localhost:18101/events
ODRA_CASPER_LIVENET_CHAIN_NAME=casper-net-1
